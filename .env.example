# Copy this file to .env and fill in the values. .env is ignored by git.

# DeepL API key, only needed for real translation runs (--deepl)
DEEPL_API_KEY=
TERMINOLOGY_SERVER=<primary_terminology_server>
BACKUP_TERMINOLOGY_SERVER=<secondary_terminology_server>

# Client certificate for the terminology servers (the key must be unencrypted)
SERVER_CERTIFICATE=<path_to_pem>
PRIVATE_KEY=<path_to_key>
LOG_LEVEL=info
